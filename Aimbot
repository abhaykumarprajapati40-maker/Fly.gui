--// ESP Functions
local function createESP(targetPlayer)
	if targetPlayer == player then return end
	
	local box = Drawing.new("Square")
	box.Visible = false
	box.Color = Color3.fromRGB(0, 255, 204)
	box.Thickness = 1.5
	box.Filled = false
	
	espCache[targetPlayer] = box
	
	targetPlayer.CharacterRemoving:Connect(function()
		if espCache[targetPlayer] then
			espCache[targetPlayer]:Remove()
			espCache[targetPlayer] = nil
		end
	end)
end

for _, p in ipairs(Players:GetPlayers()) do
	createESP(p)
end
Players.PlayerAdded:Connect(createESP)

Players.PlayerRemoving:Connect(function(p)
	if espCache[p] then
		espCache[p]:Remove()
		espCache[p] = nil
	end
end)

--// Find Closest Target Head
local function getClosestHead()
	local closestHead = nil
	local shortestDist = math.huge
	
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p.Character and p.Character:FindFirstChild("Head") then
			local hum = p.Character:FindFirstChildOfClass("Humanoid")
			if hum and hum.Health > 0 then
				local head = p.Character.Head
				local screenPos, onScreen = camera:WorldToViewportPoint(head.Position)
				if onScreen then
					local dist = (Vector2.new(screenPos.X, screenPos.Y) - Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						closestHead = head
					end
				end
			end
		end
	end
	return closestHead
end

