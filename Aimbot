--// Combat Loop (Handles both Aimbot and Aim Fixer Stabilization)
RunService.RenderStepped:Connect(function()
	-- 1. Aimbot Logic (Locks onto target head)
	if aimbotActive then
		local targetHead = getClosestPlayer()
		if targetHead then
			local targetCFrame = CFrame.new(camera.CFrame.Position, targetHead.Position)
			-- Apply smoothing so it doesn't snap abruptly
			camera.CFrame = camera.CFrame:Lerp(targetCFrame, 0.2)
		end
	end
	
	-- 2. Aim Fixer Logic (Dampens erratic screen shaking or recoil jitter)
	if aimFixerActive and not aimbotActive then
		-- Keeps camera movement fluid and reduces sudden input stutter
		local currentCamCF = camera.CFrame
