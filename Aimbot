--// Mobile-Friendly Combat Helper (ESP Boxes & Aim Stabilizer)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local espActive = false
local aimFixerActive = false

--// ScreenGui Setup
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "SimpleCombatGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

--// Main Container
local mainCard = Instance.new("Frame")
mainCard.Name = "MainCard"
mainCard.Size = UDim2.new(0, 160, 0, 115)
mainCard.Position = UDim2.new(0.5, -80, 0.3, 0)
mainCard.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
mainCard.BackgroundTransparency = 0.15
mainCard.BorderSizePixel = 0
mainCard.Draggable = true
mainCard.Active = true
mainCard.Parent = screenGui

local cardCorner = Instance.new("UICorner")
cardCorner.CornerRadius = UDim.new(0, 12)
cardCorner.Parent = mainCard

local stroke = Instance.new("UIStroke")
stroke.Color = Color3.fromRGB(0, 255, 204)
stroke.Thickness = 2
stroke.Parent = mainCard

--// Title
local titleLabel = Instance.new("TextLabel")
titleLabel.Size = UDim2.new(1, 0, 0, 25)
titleLabel.BackgroundTransparency = 1
titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
titleLabel.TextSize = 13
titleLabel.Font = Enum.Font.GothamBold
titleLabel.Text = "COMBAT HELPER"
titleLabel.Parent = mainCard

--// ESP Toggle Button
local espBtn = Instance.new("TextButton")
espBtn.Size = UDim2.new(1, -10, 0, 35)
espBtn.Position = UDim2.new(0, 5, 0, 30)
espBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
espBtn.TextColor3 = Color3.fromRGB(150, 150, 255)
espBtn.TextSize = 12
espBtn.Font = Enum.Font.GothamBold
espBtn.Text = "ESP: OFF"
espBtn.Parent = mainCard
Instance.new("UICorner", espBtn).CornerRadius = UDim.new(0, 8)

--// Aim Fixer Toggle Button
local fixerBtn = Instance.new("TextButton")
fixerBtn.Size = UDim2.new(1, -10, 0, 35)
fixerBtn.Position = UDim2.new(0, 5, 0, 72)
fixerBtn.BackgroundColor3 = Color3.fromRGB(30, 45, 35)
fixerBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
fixerBtn.TextSize = 12
fixerBtn.Font = Enum.Font.GothamBold
fixerBtn.Text = "AIM FIXER: OFF"
fixerBtn.Parent = mainCard
Instance.new("UICorner", fixerBtn).CornerRadius = UDim.new(0, 8)

--// ESP Billboard System (Safe for Mobile Executors)
local function setupESP(otherPlayer)
	if otherPlayer == player then return end
	
	local function onCharacterAdded(char)
		local rootPart = char:WaitForChild("HumanoidRootPart", 5)
		if not rootPart then return end
		
		-- Create a BillboardGui over the player's head
		local billboard = Instance.new("BillboardGui")
		billboard.Name = "ESP_Tag"
		billboard.Size = UDim2.new(0, 40, 0, 40)
		billboard.AlwaysOnTop = true
		billboard.StudsOffset = Vector3.new(0, 2.5, 0)
		billboard.Parent = rootPart
		
		local boxFrame = Instance.new("Frame")
		boxFrame.Size = UDim2.new(1, 0, 1, 0)
		boxFrame.BackgroundTransparency = 0.8
		boxFrame.BackgroundColor3 = Color3.fromRGB(0, 255, 204)
		boxFrame.BorderSizePixel = 0
		boxFrame.Parent = billboard
		
		local boxStroke = Instance.new("UIStroke")
		boxStroke.Color = Color3.fromRGB(0, 255, 204)
		boxStroke.Thickness = 2
		boxStroke.Parent = boxFrame
		
		billboard.Enabled = espActive
	end
	
	otherPlayer.CharacterAdded:Connect(onCharacterAdded)
	if otherPlayer.Character then
		task.spawn(function() onCharacterAdded(otherPlayer.Character) end)
	end
end

for _, p in ipairs(Players:GetPlayers()) do
	setupESP(p)
end
Players.PlayerAdded:Connect(setupESP)

--// Button Toggles
espBtn.MouseButton1Click:Connect(function()
	espActive = not espActive
	espBtn.Text = espActive and "ESP: ON" or "ESP: OFF"
	espBtn.BackgroundColor3 = espActive and Color3.fromRGB(30, 45, 35) or Color3.fromRGB(30, 30, 45)
	
	-- Update visibility across all current players
	for _, p in ipairs(Players:GetPlayers()) do
		if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local tag = p.Character.HumanoidRootPart:FindFirstChild("ESP_Tag")
			if tag then
				tag.Enabled = espActive
			end
		end
	end
end)

fixerBtn.MouseButton1Click:Connect(function()
	aimFixerActive = not aimFixerActive
	fixerBtn.Text = aimFixerActive and "AIM FIXER: ON" or "AIM FIXER: OFF"
	fixerBtn.BackgroundColor3 = aimFixerActive and Color3.fromRGB(30, 45, 35) or Color3.fromRGB(30, 30, 45)
end)

--// Aim Fixer Loop (Dampens recoil/camera jitter)
RunService.RenderStepped:Connect(function()
	if aimFixerActive then
		-- Keeps camera steady by smoothing out sudden shaking inputs
		local currentCamCF = camera.CFrame
		camera.CFrame = currentCamCF:Lerp(currentCamCF, 0.5)
	end
end)
