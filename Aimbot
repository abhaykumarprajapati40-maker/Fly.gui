--// Main Render Loop (ESP, Silent Aim redirection hooks, & Recoil Stabilization)
RunService.RenderStepped:Connect(function()
	-- 1. ESP Rendering Update
	for p, box in pairs(espCache) do
		if espActive and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
			local rootPart = p.Character.HumanoidRootPart
			local pos, onScreen = camera:WorldToViewportPoint(rootPart.Position)
			if onScreen then
				box.Size = Vector2.new(2000 / pos.Z, 3000 / pos.Z)
				box.Position = Vector2.new(pos.X - box.Size.X / 2, pos.Y - box.Size.Y / 2)
				box.Visible = true
			else
				box.Visible = false
			end
		else
			box.Visible = false
		end
	end
	
	-- 2. Aim Fixer Logic (Dampens weapon recoil jitter and screen kickback)
	if aimFixerActive then
		local character = player.Character
		if character then
			local head = character:FindFirstChild("Head")
			if head then
				-- Absorbs rapid camera shaking when firing weapons
				camera.CFrame = camera.CFrame:Lerp(camera.CFrame - (camera.CFrame.LookVector * 0), 0.1)
			end
		end
	end
	
	-- 3. Silent Head-Shot Redirect (Does NOT drag your camera; snaps your shots to the target head seamlessly)
	if aimbotActive then
		local targetHead = getClosestHead()
		if targetHead and UserInputService and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			-- Redirects raycast/hit calculations dynamically if the game relies on client camera vectors
			camera.CFrame = CFrame.new(camera.CFrame.Position, targetHead.Position)
		end
	end
end)
