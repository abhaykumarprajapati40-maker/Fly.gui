local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local me = Players.LocalPlayer
local enabled = true
local folder = Instance.new("Folder")
folder.Name = "BlueESPHighlights"
folder.Parent = workspace

-- GUI
local gui = Instance.new("ScreenGui")
gui.Name = "BlueESP"
gui.ResetOnSpawn = false
gui.Parent = me:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.fromOffset(180, 85)
frame.Position = UDim2.new(0, 20, 0.4, 0)
frame.BackgroundColor3 = Color3.fromRGB(15, 25, 50)
frame.Active = true
frame.Draggable = true
frame.Parent = gui

Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 12)

local title = Instance.new("TextLabel")
title.Size = UDim2.new(1, 0, 0, 30)
title.BackgroundTransparency = 1
title.Text = "BLUE ESP"
title.TextColor3 = Color3.fromRGB(0, 170, 255)
title.Font = Enum.Font.GothamBold
title.TextSize = 18
title.Parent = frame

local button = Instance.new("TextButton")
button.Size = UDim2.new(1, -20, 0, 35)
button.Position = UDim2.fromOffset(10, 40)
button.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
button.TextColor3 = Color3.new(1, 1, 1)
button.Text = "ESP: ON"
button.Font = Enum.Font.GothamBold
button.TextSize = 15
button.Parent = frame

Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

local highlights = {}

local function updatePlayer(player)
    if player == me then return end

    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end

    if not enabled or not player.Character then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "BluePlayerHighlight"
    highlight.FillColor = Color3.fromRGB(0, 100, 255)
    highlight.OutlineColor = Color3.fromRGB(100, 220, 255)
    highlight.FillTransparency = 0.45
    highlight.OutlineTransparency = 0
    highlight.Adornee = player.Character
    highlight.Parent = folder

    highlights[player] = highlight
end

local function setupPlayer(player)
    if player == me then return end

    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        updatePlayer(player)
    end)

    if player.Character then
        updatePlayer(player)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)
    if highlights[player] then
        highlights[player]:Destroy()
        highlights[player] = nil
    end
end)

button.Activated:Connect(function()
    enabled = not enabled
    button.Text = enabled and "ESP: ON" or "ESP: OFF"
    button.BackgroundColor3 = enabled
        and Color3.fromRGB(0, 120, 255)
        or Color3.fromRGB(70, 70, 80)

    for _, player in ipairs(Players:GetPlayers()) do
        updatePlayer(player)
    end
end)
