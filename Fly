--// Fly GUI v5 (High-Speed Optimized with Anti-Kick Damping)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local camera = Workspace.CurrentCamera

local flying = false
local speed = 10 -- Default speed

local bodyVelocity, bodyGyro

--// ScreenGui Setup
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "FlyGuiFullSpeed"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

--// Main Container
local mainCard = Instance.new("Frame")
mainCard.Name = "MainCard"
mainCard.Size = UDim2.new(0, 160, 0, 75)
mainCard.Position = UDim2.new(0.5, -80, 0, 15)
mainCard.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
mainCard.BackgroundTransparency = 0.15
mainCard.BorderSizePixel = 0
mainCard.Draggable = true
mainCard.Active = true
mainCard.Parent = screenGui

Instance.new("UICorner", mainCard).CornerRadius = UDim.new(0, 12)

local stroke = Instance.new("UIStroke")
stroke.Thickness = 2.5
stroke.Parent = mainCard

--// Toggle Button
local toggleBtn = Instance.new("TextButton")
toggleBtn.Size = UDim2.new(1, -10, 0, 30)
toggleBtn.Position = UDim2.new(0, 5, 0, 5)
toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 45)
toggleBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
toggleBtn.TextSize = 13
toggleBtn.Font = Enum.Font.GothamBold
toggleBtn.Text = "FLY: OFF"
toggleBtn.Parent = mainCard
Instance.new("UICorner", toggleBtn).CornerRadius = UDim.new(0, 8)

--// Speed Holder
local speedHolder = Instance.new("Frame")
speedHolder.Size = UDim2.new(1, -10, 0, 30)
speedHolder.Position = UDim2.new(0, 5, 0, 40)
speedHolder.BackgroundTransparency = 1
speedHolder.Parent = mainCard

local minusBtn = Instance.new("TextButton")
minusBtn.Size = UDim2.new(0, 30, 0, 30)
minusBtn.BackgroundColor3 = Color3.fromRGB(45, 30, 45)
minusBtn.TextColor3 = Color3.fromRGB(255, 100, 100)
minusBtn.TextSize = 16
minusBtn.Font = Enum.Font.GothamBold
minusBtn.Text = "-"
minusBtn.Parent = speedHolder
Instance.new("UICorner", minusBtn).CornerRadius = UDim.new(0, 6)

local speedLabel = Instance.new("TextLabel")
speedLabel.Size = UDim2.new(0, 70, 0, 30)
speedLabel.Position = UDim2.new(0, 35, 0, 0)
speedLabel.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
speedLabel.TextColor3 = Color3.fromRGB(0, 255, 204)
speedLabel.TextSize = 12
speedLabel.Font = Enum.Font.GothamBold
speedLabel.Text = "SPD: 10"
speedLabel.Parent = speedHolder
Instance.new("UICorner", speedLabel).CornerRadius = UDim.new(0, 6)

local plusBtn = Instance.new("TextButton")
plusBtn.Size = UDim2.new(0, 30, 0, 30)
plusBtn.Position = UDim2.new(0, 110, 0, 0)
plusBtn.BackgroundColor3 = Color3.fromRGB(30, 45, 35)
plusBtn.TextColor3 = Color3.fromRGB(100, 255, 100)
plusBtn.TextSize = 16
plusBtn.Font = Enum.Font.GothamBold
plusBtn.Text = "+"
plusBtn.Parent = speedHolder
Instance.new("UICorner", plusBtn).CornerRadius = UDim.new(0, 6)

--// Speed Controls (Increased max range to 250)
plusBtn.MouseButton1Click:Connect(function()
	if speed < 250 then
		speed = speed + 5
		speedLabel.Text = "SPD: " .. speed
	end
end)

minusBtn.MouseButton1Click:Connect(function()
	if speed > 5 then
		speed = speed - 5
		speedLabel.Text = "SPD: " .. speed
	end
end)

--// Toggle Flight
local function toggleFlight()
	flying = not flying
	toggleBtn.Text = flying and "FLY: ON" or "FLY: OFF"
	toggleBtn.BackgroundColor3 = flying and Color3.fromRGB(0, 180, 90) or Color3.fromRGB(30, 30, 45)
	
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local rootPart = character.HumanoidRootPart
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		
		if flying then
			humanoid.PlatformStand = true
			if bodyVelocity then bodyVelocity:Destroy() end
			if bodyGyro then bodyGyro:Destroy() end
			
			bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bodyVelocity.Velocity = Vector3.new(0, 0, 0)
			bodyVelocity.Parent = rootPart
			
			bodyGyro = Instance.new("BodyGyro")
			bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
			bodyGyro.P = 15000
			bodyGyro.Parent = rootPart
		else
			if bodyVelocity then bodyVelocity:Destroy() end
			if bodyGyro then bodyGyro:Destroy() end
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

toggleBtn.MouseButton1Click:Connect(toggleFlight)

--// Movement Loop with Anti-Kick Damping
RunService.RenderStepped:Connect(function()
	local hue = (tick() % 5) / 5
	stroke.Color = Color3.fromHSV(hue, 1, 1)
	
	if not flying then return end
	
	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid or not bodyVelocity or not bodyGyro then return end
	
	local moveDir = humanoid.MoveDirection
	local cf = camera.CFrame
	local targetVelocity = Vector3.new(0, 0, 0)
	
	if moveDir.Magnitude > 0 then
		-- Allows high speeds up to 250 while blending vectors to reduce instant kick triggers
		targetVelocity = (cf.RightVector * moveDir.X + cf.LookVector * -moveDir.Z) * (speed * 2)
	end
	
	-- Gradual interpolation prevents abrupt frame-1 positional teleport flags
	bodyVelocity.Velocity = bodyVelocity.Velocity:Lerp(targetVelocity, 0.3)
	bodyGyro.CFrame = cf
end)
