end
--// Toggle Flight Function (Safely Cleans Up Physics to Prevent Air Freezing)
local function toggleFlight()
	flying = not flying
	toggleBtn.Text = flying and "FLY: ON" or "FLY: OFF"
	toggleBtn.BackgroundColor3 = flying and Color3.fromRGB(0, 180, 90) or Color3.fromRGB(30, 30, 45)
	
	local character = player.Character
	if character and character:FindFirstChild("HumanoidRootPart") then
		local rootPart = character.HumanoidRootPart
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		
		if flying then
			humanoid.PlatformStand = true
			
			if bodyVelocity then bodyVelocity:Destroy() end
			if bodyGyro then bodyGyro:Destroy() end
			
			bodyVelocity = Instance.new("BodyVelocity")
			bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
			bodyVelocity.Velocity = Vector3.new(0, 0, 0)
			bodyVelocity.Parent = rootPart
			
			bodyGyro = Instance.new("BodyGyro")
			bodyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
			bodyGyro.P = 10000
			bodyGyro.Parent = rootPart
		else
			-- Completely wipe physics instances so gravity pulls you down immediately
			if bodyVelocity then bodyVelocity:Destroy() end
			if bodyGyro then bodyGyro:Destroy() end
			
			humanoid.PlatformStand = false
			humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
	end
end

toggleBtn.MouseButton1Click:Connect(toggleFlight)

--// RGB Color Cycle & Flight Movement Loop
RunService.RenderStepped:Connect(function(dt)
	local hue = (tick() % 5) / 5
	stroke.Color = Color3.fromHSV(hue, 1, 1)
	
	if not flying then return end
	
	local character = player.Character
	if not character then return end
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not rootPart or not humanoid or not bodyVelocity or not bodyGyro then return end
	
	local moveDir = humanoid.MoveDirection
	local cf = camera.CFrame
	local velocity = Vector3.new(0, 0, 0)
	
	if moveDir.Magnitude > 0 then
		local calculatedSpeed = math.clamp(speed * 1.5, 1, 120)
		velocity = (cf.RightVector * moveDir.X + cf.LookVector * -moveDir.Z) * calculatedSpeed
	end
	
	bodyVelocity.Velocity = velocity
	bodyGyro.CFrame = cf
end)
